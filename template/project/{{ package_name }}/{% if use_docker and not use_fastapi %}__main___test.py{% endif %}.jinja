import runpy

import pytest

from {{ package_name }} import __version__


def test_module_runs_as_main(capsys: pytest.CaptureFixture[str]) -> None:
    """`python -m {{ package_name }}` writes one line and exits."""
    runpy.run_module("{{ package_name }}", run_name="__main__")

    expected = f"{{ project_name }} {__version__}"
    assert capsys.readouterr().out.strip() == expected
