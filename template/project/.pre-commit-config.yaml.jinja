# commit-msg installs the conventional-commit check below alongside pre-commit.
default_install_hook_types: [pre-commit, commit-msg]

repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-toml
      - id: check-json
        # .vscode/settings.json is JSONC (comments); the editor owns its format.
        exclude: ^\.vscode/settings\.json$
      - id: pretty-format-json
        args: [--autofix]
        exclude: ^\.vscode/settings\.json$
      - id: detect-private-key
      - id: detect-aws-credentials
        args: [--allow-missing-credentials]

  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks

  - repo: https://github.com/shellcheck-py/shellcheck-py
    rev: v0.11.0.1
    hooks:
      - id: shellcheck

  - repo: https://github.com/igorshubovych/markdownlint-cli
    rev: v0.49.1
    hooks:
      - id: markdownlint
        # Agent instructions are prose for models, not documents.
        exclude: ^\.claude/

  - repo: local
    hooks:
{%- if use_docker %}
      - id: check-container-version
        name: check container version
        entry: >-
          bash -c '
          metadata_file=$(mktemp);
          cleanup() { unlink "$metadata_file"; };
          trap cleanup EXIT;
          docker buildx build --call=outline --metadata-file "$metadata_file" . >/dev/null &&
          project_version=$(uv run tomlq -r ".project.version" pyproject.toml) &&
          image_version=$(uv run yq -r ".[\"result.json\"].args[] | select(.name == \"IMAGE_VERSION\") | .value" "$metadata_file") &&
          test "$project_version" = "$image_version" &&
          uv run pysemver check "$project_version" >/dev/null'
        language: system
        files: ^(Dockerfile|pyproject\.toml)$
        pass_filenames: false

{%- endif %}
      - id: ruff-fix
        name: ruff fix (lint + import sort)
        entry: uv run ruff check --fix
        language: system
        types_or: [python, pyi]

      - id: ruff-format
        name: ruff format
        entry: uv run ruff format
        language: system
        types_or: [python, pyi]

      - id: forbid-section-separator-comments
        name: forbid section-separator comments
        entry: '^\s*#\s*(?:[-=]{3,}|#{2,})(?:\s+.*)?$'
        language: pygrep
        types_or: [python, pyi]

      # Tests are *_test.py beside the module (docs/decisions/0005). pytest is configured
      # for that name only, so a test_*.py file would be silently never collected.
      - id: forbid-test-prefix
        name: test files are *_test.py, not test_*.py
        entry: rename to <module>_test.py; pytest collects only *_test.py
        language: fail
        files: (^|/)test_[^/]*\.py$

      # Conventional Commits subject, 72 characters or fewer (docs/DEVELOPMENT.md).
      # Merge and revert subjects that git writes itself are allowed through.
      - id: conventional-commit-subject
        name: conventional commit subject
        entry: '\A(?=[^\n]{1,72}(\n|\Z))((feat|fix|refactor|chore|docs|test|ci|style|perf|build)(\([^()\n]+\))?!?: \S|Merge |Revert ")'
        language: pygrep
        args: [--multiline, --negate]
        stages: [commit-msg]

      - id: mypy
        name: mypy
        entry: env MYPY_NUM_WORKERS=8 uv run mypy
        language: system
        pass_filenames: false
        always_run: true
        require_serial: true

      - id: basedpyright
        name: basedpyright
        entry: uv run basedpyright
        language: system
        pass_filenames: false
        always_run: true

      - id: bandit
        name: bandit
        entry: uv run bandit -c pyproject.toml -r .
        language: system
        pass_filenames: false
        always_run: true

      - id: pip-audit
        name: pip-audit
        entry: uv run pip-audit
        language: system
        pass_filenames: false
        always_run: true

      - id: unit-tests
        name: unit tests
        entry: >-
          bash -c 'uv run pytest -m "not integration and not live" --cov --cov-report=xml'
        language: system
        pass_filenames: false
        always_run: true

      # Changed-line coverage against origin/main. Skips with a note when the
      # remote or branch does not exist yet (fresh project, detached CI checkout).
      - id: diff-cover
        name: Python line coverage (changed lines only)
        # A literal block: a folded (>-) scalar keeps the newlines of indented lines,
        # which split the diff-cover flags into separate shell commands.
        entry: |
          bash -c '
            git fetch -q origin main 2>/dev/null || true
            if git rev-parse --verify -q origin/main >/dev/null; then
              uv run diff-cover coverage.xml --compare-branch=origin/main --fail-under=80 --total-percent-float
            else
              echo "diff-cover: origin/main not found, skipping"
            fi'
        language: system
        pass_filenames: false
        always_run: true
        verbose: true
