# Codex cloud/worktree environment. Copies the untracked local files listed in
# .worktreeinclude into the worktree, builds the virtualenv, installs hooks.
version = 1
name = "{{ project_name }}"

[setup]
script = '''
#!/bin/bash
set -euo pipefail

# Entries are copied into the worktree; an absolute path or a .. component could
# reach outside it, so such lines are skipped.
unsafe_entry() {
  case "/$1/" in
    //* | /~* | */../*) return 0 ;;
  esac
  return 1
}

while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"
  line="${line%"${line##*[![:space:]]}"}"
  [ -z "$line" ] && continue
  if unsafe_entry "$line"; then
    echo "warning: skipping unsafe .worktreeinclude entry $line" >&2
    continue
  fi
  src="${CODEX_SOURCE_TREE_PATH}/${line}"
  dst="${CODEX_WORKTREE_PATH}/${line}"
  if [ ! -e "$src" ]; then
    echo "warning: $src does not exist, skipping" >&2
    continue
  fi
  mkdir -p "$(dirname "$dst")"
  rm -rf -- "$dst"
  cp -Rp "$src" "$dst"
done < "${CODEX_SOURCE_TREE_PATH}/.worktreeinclude"

cd "$CODEX_WORKTREE_PATH"

# AGENTS.md is the tracked source of truth. Machine-local extra context is
# CLAUDE.local.md; Codex reads AGENTS.override.md instead of AGENTS.md when it
# exists, so the override carries both.
if [ -f CLAUDE.local.md ]; then
  cat AGENTS.md CLAUDE.local.md > AGENTS.override.md
else
  # Codex prefers AGENTS.override.md, so a leftover copy would freeze AGENTS.md as it was
  # when CLAUDE.local.md last existed.
  rm -f AGENTS.override.md
fi

rm -rf .venv && uv sync --all-groups --all-extras
source .venv/bin/activate
# Hides a system-level core.hooksPath, which pre-commit refuses to install over.
GIT_CONFIG_NOSYSTEM=1 pre-commit install'''

[cleanup]
script = '''
#!/bin/bash
set -euo pipefail

unsafe_entry() {
  case "/$1/" in
    //* | /~* | */../*) return 0 ;;
  esac
  return 1
}

while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"
  line="${line%"${line##*[![:space:]]}"}"
  [ -z "$line" ] && continue
  [ "$line" = ".codex" ] && continue
  if unsafe_entry "$line"; then
    echo "warning: skipping unsafe .worktreeinclude entry $line" >&2
    continue
  fi
  target="${CODEX_WORKTREE_PATH}/${line}"
  if [ ! -e "$target" ]; then
    continue
  fi
  rm -rf -- "$target" || echo "warning: failed to delete $target" >&2
done < "${CODEX_WORKTREE_PATH}/.worktreeinclude"'''
