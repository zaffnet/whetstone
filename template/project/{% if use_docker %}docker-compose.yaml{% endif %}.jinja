services:
  app:
    build: .
    image: ghcr.io/{{ github_owner | lower }}/{{ project_name }}:${IMAGE_TAG:-latest}
    # For local dev: IMAGE_TAG=local PULL_POLICY=never docker compose up --build
    pull_policy: ${PULL_POLICY:-always}
{%- if use_fastapi %}
    command: [ "uv", "run", "uvicorn", "{{ package_name }}.app:app", "--host", "0.0.0.0", "--port", "8080" ]
    ports:
      - "8080:8080"
{%- else %}
    # Runs the module once and exits; replace with the real entry point.
    command: [ "uv", "run", "python", "-m", "{{ package_name }}" ]
    restart: "no"
{%- endif %}
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      # Local-only development credentials; override with POSTGRES_PASSWORD in .env.
      DATABASE_URL: postgresql://app:${POSTGRES_PASSWORD:-app}@postgres:5432/app
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
{%- if use_fastapi %}
    healthcheck:
      test: [ "CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" ]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
{%- endif %}

  postgres:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-app}
    volumes:
      # postgres:18 images keep PGDATA in a version subdirectory under this mount.
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U app -d app" ]
      interval: 5s
      timeout: 3s
      retries: 5

volumes:
  pgdata:

# Local Compose overrides
#
# `cp docker-compose.override.example.yaml docker-compose.override.yaml` for a dev
# loop with the source bind-mounted and Postgres published on the host. Docker Compose
# merges the override with `docker-compose.yaml` on every `docker compose up`. The
# override is ignored by git and stays untracked because local ports, paths, and
# environment values differ from developer to developer; CI runs the committed stack.
#
# Anything machine-specific goes in the same file, for example:
#
# ```yaml
# services:
#   app:
#     environment:
#       LOG_LEVEL: DEBUG
#
#   postgres:
#     ports:
#       - "5432:5432"
# ```
