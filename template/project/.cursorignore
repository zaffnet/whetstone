# .worktreeinclude lists local-only files that new worktrees copy over. This file
# re-includes the same paths for Cursor access and indexing, except secrets: .env
# stays ignored on purpose. Overrides .gitignore and the default ignores. See
# https://cursor.com/docs/reference/ignore-file
!.claude/
!.claude/**
!.codex/
!.codex/**
!.cursor/
!.cursor/**
!.vscode/
!.vscode/**
!.worktreeinclude
!AGENTS.override.md
!CLAUDE.local.md
!docker-compose.override.yaml
