{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell"
      }
    ],{% if use_graphify %}
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "graphify hook-guard search",
            "type": "command"
          }
        ],
        "matcher": "Bash|Grep"
      },
      {
        "hooks": [
          {
            "command": "graphify hook-guard read",
            "type": "command"
          }
        ],
        "matcher": "Read|Glob"
      }
    ],{% endif %}
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.sh\"",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/code_prose_honesty.sh\"",
            "timeout": 120,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/prose_honesty.sh\"",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ]
  },
  "plansDirectory": ".claude/plans"
}
