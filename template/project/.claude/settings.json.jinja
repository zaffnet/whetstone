{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]{% if use_graphify %},
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "graphify hook-guard",
            "type": "command"
          }
        ],
        "matcher": "Read|Glob|Grep|Bash"
      }
    ]{% endif %}
  },
  "plansDirectory": ".claude/plans"
}
