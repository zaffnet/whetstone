{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree_create.sh\"; { cd \"$CLAUDE_PROJECT_DIR\" && bash -n \"$f\"; } >/dev/null 2>&1 || exit 0; bash \"$f\"",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(cd *)",
      "Bash(python3 -)",
      "Bash(cat)"
    ]
  },
  "plansDirectory": ".claude/plans"
}
