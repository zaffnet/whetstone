{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.sh\"",
            "timeout": 600,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit_comments.sh\"",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ]
  },
  "plansDirectory": ".claude/plans"
}
