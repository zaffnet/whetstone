# Dependabot's Docker parser only reads FROM lines, so the uv image is declared
# as a stage rather than referenced inline from COPY.
FROM ghcr.io/astral-sh/uv:0.12 AS uv

FROM python:{{ python_version }}-slim

# Default equals project.version; CI overrides it with
# <project-version>-dev.<run-number>.<attempt>+g<seven-character-commit>.
ARG IMAGE_VERSION="0.1.0"

LABEL org.opencontainers.image.source="https://github.com/{{ github_owner }}/{{ project_name }}" \
      org.opencontainers.image.version="${IMAGE_VERSION}"

COPY --from=uv /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

# The application uses uv; pip only widens the attack surface of the image.
RUN python -m pip uninstall --yes pip

RUN useradd --create-home --shell /usr/sbin/nologin app
WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev

COPY . .

RUN chown -R app:app /app
USER app
