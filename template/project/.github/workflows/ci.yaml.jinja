name: CI

on:
  push:
    branches: ["**"]
  pull_request:
  merge_group:
  workflow_dispatch:

permissions: {}
{%- if use_docker %}

env:
  IMAGE_NAME: {{ project_name }}
{%- endif %}

jobs:
  pre-commit-checks:
    runs-on: ubuntu-latest
    outputs:
      coverage-artifact-id: {{ '${{ steps.upload-coverage.outputs.artifact-id }}' }}
{%- if use_docker %}
      project-version: {{ '${{ steps.project-version.outputs.value }}' }}
{%- endif %}
    permissions:
      contents: read

    steps:
      - name: Checkout code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - name: Install uv
        uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
        with:
          python-version: "{{ python_version }}"

      - name: Set up Python {{ python_version }}
        run: uv python install {{ python_version }}

      - name: Install project and dev tools
        run: uv sync --group dev

      - name: Run pre-commit
        run: uv run pre-commit run --all-files

      - name: Publish Python line coverage (changed lines only)
        if: {{ "${{ !cancelled() && hashFiles('coverage.xml') != '' }}" }}
        run: |
          uv run diff-cover coverage.xml \
            --compare-branch=origin/main \
            --total-percent-float \
            --format "markdown:$RUNNER_TEMP/diff-coverage.md"
          sed '1s/^# Diff Coverage$/## Python line coverage (changed lines only)/' \
            "$RUNNER_TEMP/diff-coverage.md" >> "$GITHUB_STEP_SUMMARY"

      - id: upload-coverage
        if: {{ "${{ !cancelled() && hashFiles('coverage.xml') != '' }}" }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: coverage
          path: coverage.xml
{%- if use_docker %}

      - name: Read project version
        id: project-version
        run: echo "value=$(uv run tomlq --raw-output '.project.version' pyproject.toml)" >> "$GITHUB_OUTPUT"
{%- endif %}

  coverage:
    runs-on: ubuntu-latest
    needs: [pre-commit-checks]
    permissions:
      checks: write
      pull-requests: write
    if: {{ "${{ !cancelled() && github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository && github.event.pull_request.user.login != 'dependabot[bot]' && needs.pre-commit-checks.outputs.coverage-artifact-id != '' }}" }}
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: coverage
      - uses: 5monkeys/cobertura-action@ee5787cc56634acddedc51f21c7947985531e6eb # v14
        with:
          minimum_coverage: 80
          fail_below_threshold: false
          show_missing: true
          link_missing_lines: true
          report_name: Python line coverage (all measured files)
{%- if use_docker %}

  docker-build:
    runs-on: ubuntu-latest
    needs: [pre-commit-checks]
    permissions:
      contents: read
    steps:
      - name: Checkout code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - name: Set development image version
        shell: bash
        run: |
          PROJECT_VERSION="{{ '${{ needs.pre-commit-checks.outputs.project-version }}' }}"
          IMAGE_VERSION="${PROJECT_VERSION}-dev.${GITHUB_RUN_NUMBER}.${GITHUB_RUN_ATTEMPT}+g${GITHUB_SHA::7}"
          echo "IMAGE_VERSION=$IMAGE_VERSION" >> "$GITHUB_ENV"
      - name: Build Docker image
        run: |
          docker build \
            --build-arg "IMAGE_VERSION=$IMAGE_VERSION" \
            --tag "$IMAGE_NAME:{{ '${{ github.sha }}' }}" \
            .
      - name: Save image as tar for scanning
        run: docker save "$IMAGE_NAME:{{ '${{ github.sha }}' }}" -o image.tar
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: docker-image
          path: image.tar
          retention-days: 1

  image-scan:
    runs-on: ubuntu-latest
    needs: [pre-commit-checks, docker-build]
    permissions:
      contents: read
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: docker-image
      - name: Load Docker image
        run: docker load -i image.tar
      - name: Scan image for vulnerabilities (JSON report)
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: {{ '${{ env.IMAGE_NAME }}:${{ github.sha }}' }}
          format: json
          output: trivy-results.json
          severity: CRITICAL,HIGH
          ignore-unfixed: true
      - name: Upload Trivy results
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: trivy-results
          path: trivy-results.json
      - name: Scan image for vulnerabilities (Trivy)
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: {{ '${{ env.IMAGE_NAME }}:${{ github.sha }}' }}
          format: table
          exit-code: "1"
          severity: CRITICAL,HIGH
          ignore-unfixed: true

  docker-push:
    runs-on: ubuntu-latest
    needs: [pre-commit-checks, image-scan]
    if: github.event_name == 'push'
    permissions:
      contents: read
      packages: write
    env:
      REGISTRY: ghcr.io
      IMAGE_PATH: ghcr.io/{{ github_owner | lower }}/{{ project_name }}
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: docker-image
      - name: Load Docker image
        run: docker load -i image.tar
      - name: Log in to GitHub Container Registry
        run: echo "{{ '${{ secrets.GITHUB_TOKEN }}' }}" | docker login "$REGISTRY" -u "{{ '${{ github.actor }}' }}" --password-stdin
      - name: Tag and push image
        run: |
          SAFE_REF=$(echo "${GITHUB_REF_NAME}" | tr '/' '-' | tr -cd '[:alnum:]._-' | sed 's/^[^a-zA-Z0-9_]*//' | cut -c1-100)
          SAFE_REF=${SAFE_REF:-unknown}
          docker tag "$IMAGE_NAME:{{ '${{ github.sha }}' }}" \
            "$IMAGE_PATH:${SAFE_REF}-${GITHUB_SHA::7}"
          docker push "$IMAGE_PATH:${SAFE_REF}-${GITHUB_SHA::7}"
          if [ "$GITHUB_REF_NAME" = "main" ]; then
            docker tag "$IMAGE_NAME:{{ '${{ github.sha }}' }}" "$IMAGE_PATH:latest"
            docker push "$IMAGE_PATH:latest"
          fi
{%- endif %}
