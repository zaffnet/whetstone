#!/usr/bin/env python3
"""Copy ~/.agents/mcp.json into Cursor, Claude Code, and Codex user configs.

Needs Python 3.11 or newer for tomllib, which the system python3 on macOS is not.
Run it as `uv run --no-project --python 3.12 python ~/.agents/bin/sync-mcp`.
"""

from __future__ import annotations

import json
import os
import re
import shutil
import sys
import tempfile
import tomllib
from datetime import UTC, datetime
from pathlib import Path
from typing import NoReturn, NotRequired, TypedDict, TypeGuard


class ServerSpec(TypedDict):
    """A single entry of the mcpServers object in ~/.agents/mcp.json."""

    type: NotRequired[str]
    url: NotRequired[str]
    command: NotRequired[str]
    args: NotRequired[list[str]]
    env: NotRequired[dict[str, str]]
    headers: NotRequired[dict[str, str]]


HOME = Path.home()
AGENTS_MCP = HOME / ".agents" / "mcp.json"
CURSOR_MCP = HOME / ".cursor" / "mcp.json"
CLAUDE_JSON = HOME / ".claude.json"
CODEX_TOML = HOME / ".codex" / "config.toml"

CODEX_PRIVATE = frozenset({"node_repl", "computer-use", "event-stream"})
# Read off TOML's own ABNF rather than approximated, because a header this misses reads as
# an ordinary line and is absorbed into the chunk above it, and when that chunk is an
# unmanaged [mcp_servers.*] table being dropped, it goes with it. The grammar is
# `ws table ws [ comment ]`, where a key part is an unquoted run or a whole quoted string --
# so leading tabs and spaces are allowed, and a ] or a # inside quotes is content. The
# shapes an approximation misses: [[array.of.tables]], a trailing comment, a ] inside a
# quoted key, a leading indent.
TABLE_HEADER = re.compile(
    r"^[ \t]*\[\[?((?:[^]\"']|\"(?:[^\"\\]|\\.)*\"|'[^']*')+)\]\]?\s*(?:#.*)?$"
)
ENV_PLACEHOLDER = re.compile(r"^\$\{([A-Za-z_][A-Za-z0-9_]*)\}$")
BEARER_PLACEHOLDER = re.compile(r"^Bearer \$\{([A-Za-z_][A-Za-z0-9_]*)\}$")
# env keys exempt from the literal-secret refusal below: their values may be literal.
PLAIN_ENV_KEYS = frozenset({"AWS_PROFILE", "AWS_REGION", "AWS_DEFAULT_REGION", "LOG_LEVEL"})
PLAIN_ENV_SUFFIXES = ("_REGION", "_LOG_LEVEL")
BACKUP_SUFFIX = ".bak-before-agents-sync-"
BACKUP_KEEP = 5


def die(message: str) -> NoReturn:
    print(f"sync-mcp: {message}", file=sys.stderr)  # noqa: T201  -- CLI diagnostics
    raise SystemExit(1)


def is_object(value: object) -> TypeGuard[dict[str, object]]:
    """JSON and TOML keys are always strings."""
    return isinstance(value, dict)


def as_str(value: object, label: str) -> str:
    if not isinstance(value, str):
        die(f"{label} must be a string")
    return value


def is_array(value: object) -> TypeGuard[list[object]]:
    return isinstance(value, list)


def as_str_list(value: object, label: str) -> list[str]:
    if not is_array(value):
        die(f"{label} must be an array")
    return [as_str(item, f"{label} entries") for item in value]


def as_str_map(value: object, label: str) -> dict[str, str]:
    if not is_object(value):
        die(f"{label} must be an object")
    return {key: as_str(item, f"{label}.{key}") for key, item in value.items()}


def as_placeholder_headers(value: object, name: str) -> dict[str, str]:
    """Raise SystemExit if a header is mistyped or carries a literal secret."""
    headers = as_str_map(value, f"{name}.headers")
    for header, item in headers.items():
        if ENV_PLACEHOLDER.match(item) is None and BEARER_PLACEHOLDER.match(item) is None:
            placeholder = f"{name}.headers.{header} must be ${{VAR}} or Bearer ${{VAR}}"
            die(f"{placeholder}; refusing a literal secret")
    return headers


def as_placeholder_env(value: object, name: str) -> dict[str, str]:
    """Raise SystemExit if an env entry is mistyped or carries a literal secret."""
    env = as_str_map(value, f"{name}.env")
    for key, item in env.items():
        if ENV_PLACEHOLDER.match(item) is None and not is_plain_env_key(key):
            die(f"{name}.env.{key} must be ${{VAR}}; refusing a literal secret")
    return env


def as_server_spec(value: object, name: str) -> ServerSpec:
    """Raise SystemExit if the entry is mistyped or holds a literal secret."""
    if not is_object(value):
        die(f"{name} must be an object")
    spec: ServerSpec = {}
    if "type" in value:
        spec["type"] = as_str(value["type"], f"{name}.type")
    if "url" in value:
        spec["url"] = as_str(value["url"], f"{name}.url")
    if "command" in value:
        spec["command"] = as_str(value["command"], f"{name}.command")
    if "args" in value:
        spec["args"] = as_str_list(value["args"], f"{name}.args")
    if "headers" in value:
        spec["headers"] = as_placeholder_headers(value["headers"], name)
    if "env" in value:
        spec["env"] = as_placeholder_env(value["env"], name)
    # A key ServerSpec does not declare would vanish silently when this spec is written.
    unknown = set(value) - set(ServerSpec.__annotations__)
    if len(unknown) > 0:
        die(f"{name} has keys this script would drop: {sorted(unknown)}")
    return spec


def load_managed() -> dict[str, ServerSpec]:
    try:
        payload = json.loads(AGENTS_MCP.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        die(f"cannot read {AGENTS_MCP}: {exc}")
    if not is_object(payload):
        die(f"{AGENTS_MCP} must contain an object")
    servers = payload.get("mcpServers")
    if not is_object(servers) or len(servers) == 0:
        die(f"{AGENTS_MCP} must contain a non-empty mcpServers object")
    return {name: as_server_spec(spec, name) for name, spec in servers.items()}


def is_plain_env_key(key: str) -> bool:
    return key in PLAIN_ENV_KEYS or key.endswith(PLAIN_ENV_SUFFIXES)


def backup(path: Path) -> None:
    """Copy the file aside before this run rewrites it.

    Stamped, not one fixed name. A single name is overwritten every run, so a run that
    corrupts the file backs up the corrupt copy over the last good one -- the backup is
    gone exactly when it is wanted. Stamps accumulate, so keep the newest BACKUP_KEEP and
    delete the rest; the glob also collects the one fixed-name backup older versions left.

    Microseconds, not seconds: two runs in the same second collide on the name and the
    second overwrites the first. The width is fixed, so the names still sort oldest-first.
    """
    if not path.exists() or path.is_symlink():
        return
    stamp = datetime.now(tz=UTC).strftime("%Y%m%dT%H%M%S.%fZ")
    _ = shutil.copy2(path, path.with_name(f"{path.name}{BACKUP_SUFFIX}{stamp}"))
    kept = sorted(path.parent.glob(f"{path.name}.bak-before-agents-sync*"))
    for stale in kept[:-BACKUP_KEEP]:
        stale.unlink()


def sync_cursor() -> None:
    CURSOR_MCP.parent.mkdir(parents=True, exist_ok=True)
    if CURSOR_MCP.is_symlink() and CURSOR_MCP.resolve() == AGENTS_MCP.resolve():
        return
    if CURSOR_MCP.exists() and not CURSOR_MCP.is_symlink():
        backup(CURSOR_MCP)
        CURSOR_MCP.unlink()
    elif CURSOR_MCP.is_symlink():
        CURSOR_MCP.unlink()
    CURSOR_MCP.symlink_to(AGENTS_MCP)


def sync_claude(servers: dict[str, ServerSpec]) -> int:
    """Replace Claude user-scope servers and empty every project's local scope.

    Returns the number of local-scope server entries removed.
    """
    if not CLAUDE_JSON.exists():
        die(f"missing {CLAUDE_JSON}")
    backup(CLAUDE_JSON)
    try:
        data = json.loads(CLAUDE_JSON.read_text())
    except json.JSONDecodeError as exc:
        die(f"cannot parse {CLAUDE_JSON}: {exc}")
    if not is_object(data):
        die(f"{CLAUDE_JSON} must contain an object")
    data["mcpServers"] = servers
    removed = 0
    projects = data.get("projects")
    if is_object(projects):
        for project in projects.values():
            if not is_object(project):
                continue
            local = project.pop("mcpServers", None)
            if is_object(local):
                removed += len(local)
    fd, tmp = tempfile.mkstemp(prefix="claude.json.", dir=CLAUDE_JSON.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, indent=2, ensure_ascii=False)
            _ = handle.write("\n")
        _ = Path(tmp).replace(CLAUDE_JSON)
    except Exception:
        Path(tmp).unlink(missing_ok=True)
        raise
    validate_claude(servers)
    return removed


def validate_claude(servers: dict[str, ServerSpec]) -> None:
    """Re-read the written file and confirm it holds exactly the managed servers.

    Raises:
        SystemExit: if the user scope does not match, or a local scope survived.

    """
    written = json.loads(CLAUDE_JSON.read_text())
    if not is_object(written):
        die(f"{CLAUDE_JSON} must contain an object")
    written_servers = written.get("mcpServers")
    if not is_object(written_servers) or set(written_servers) != set(servers):
        die("Claude mcpServers keys do not match ~/.agents/mcp.json")
    written_projects = written.get("projects")
    leftover: list[str] = []
    if is_object(written_projects):
        leftover = [
            path
            for path, project in written_projects.items()
            if is_object(project) and is_object(project.get("mcpServers"))
        ]
    if len(leftover) > 0:
        die(f"Claude local-scope servers survived in: {leftover}")


def toml_string(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def env_var_name(value: str) -> str:
    match = BEARER_PLACEHOLDER.match(value)
    if match is None:
        match = ENV_PLACEHOLDER.match(value)
    if match is None:
        die(f"expected ${{VAR}} placeholder, got {value!r}")
    return match.group(1)


def server_to_toml(name: str, spec: ServerSpec) -> str:
    lines = [f"[mcp_servers.{name}]"]
    headers = spec.get("headers", {})
    url = spec.get("url")
    if url is not None:
        lines.append(f"url = {toml_string(url)}")
        authorization = headers.get("Authorization")
        if authorization is not None:
            lines.append(f"bearer_token_env_var = {toml_string(env_var_name(authorization))}")
        extra = {key: value for key, value in headers.items() if key != "Authorization"}
        if len(extra) > 0:
            lines.append("")
            lines.append(f"[mcp_servers.{name}.env_http_headers]")
            for key, value in extra.items():
                lines.append(f"{key} = {toml_string(env_var_name(value))}")
        return "\n".join(lines) + "\n"
    command = spec.get("command")
    if command is None or len(command) == 0:
        die(f"{name} needs command or url")
    lines.append(f"command = {toml_string(command)}")
    args = spec.get("args", [])
    if len(args) > 0:
        rendered = ", ".join(toml_string(arg) for arg in args)
        lines.append(f"args = [{rendered}]")
    env = spec.get("env", {})
    if len(env) > 0:
        lines.append("")
        lines.append(f"[mcp_servers.{name}.env]")
        for key, value in env.items():
            lines.append(f"{key} = {toml_string(value)}")
    return "\n".join(lines) + "\n"


def split_toml_tables(text: str) -> list[tuple[str | None, str]]:
    chunks: list[tuple[str | None, str]] = []
    current_header: str | None = None
    current_lines: list[str] = []
    for line in text.splitlines(keepends=True):
        match = TABLE_HEADER.match(line.rstrip("\n"))
        if match is not None:
            chunks.append((current_header, "".join(current_lines)))
            current_header = match.group(1)
            current_lines = [line]
        else:
            current_lines.append(line)
    chunks.append((current_header, "".join(current_lines)))
    return chunks


def mcp_server_name(header: str | None) -> str | None:
    if header is None:
        return None
    header = header.strip()
    if not header.startswith("mcp_servers."):
        return None
    return header.split(".")[1].strip()


def sync_codex(servers: dict[str, ServerSpec]) -> None:
    if not CODEX_TOML.exists():
        die(f"missing {CODEX_TOML}")
    backup(CODEX_TOML)
    original = CODEX_TOML.read_text()
    chunks = split_toml_tables(original)
    private_chunks = [body for header, body in chunks if mcp_server_name(header) in CODEX_PRIVATE]
    managed_block = "".join(server_to_toml(name, spec) + "\n" for name, spec in servers.items())
    output: list[str] = []
    inserted = False
    for header, body in chunks:
        name = mcp_server_name(header)
        if name is None:
            output.append(body)
            continue
        if inserted:
            continue
        output.extend(private_chunks)
        output.append(managed_block)
        inserted = True
    if not inserted:
        output.extend(private_chunks)
        output.append(managed_block)
    text = "".join(output)
    text = re.sub(r"\n{3,}", "\n\n", text)
    if not text.endswith("\n"):
        text += "\n"
    try:
        _ = tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        die(f"refusing to write {CODEX_TOML}: generated text is not valid TOML: {exc}")
    fd, tmp = tempfile.mkstemp(prefix="config.toml.", dir=CODEX_TOML.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            _ = handle.write(text)
        _ = Path(tmp).replace(CODEX_TOML)
    except Exception:
        Path(tmp).unlink(missing_ok=True)
        raise
    validate_codex(servers)


def validate_codex(servers: dict[str, ServerSpec]) -> None:
    parsed = tomllib.loads(CODEX_TOML.read_text())
    table = parsed.get("mcp_servers")
    found: dict[str, object] = table if is_object(table) else {}
    missing_private = CODEX_PRIVATE - set(found)
    if len(missing_private) > 0:
        # Codex writes these itself on first launch; absent is normal on a fresh machine.
        print(  # noqa: T201  -- CLI diagnostics
            f"sync-mcp: Codex private servers not present yet: {sorted(missing_private)}",
            file=sys.stderr,
        )
    missing_managed = set(servers) - set(found)
    if len(missing_managed) > 0:
        die(f"Codex missing managed servers: {sorted(missing_managed)}")
    extras = set(found) - set(servers) - CODEX_PRIVATE
    if len(extras) > 0:
        die(f"Codex still has unmanaged servers: {sorted(extras)}")


def main() -> None:
    servers = load_managed()
    sync_cursor()
    removed = sync_claude(servers)
    sync_codex(servers)
    print(f"synced {len(servers)} MCP servers from {AGENTS_MCP}")  # noqa: T201  -- CLI report
    print(f"  Cursor: {CURSOR_MCP} -> {AGENTS_MCP}")  # noqa: T201  -- CLI report
    print(f"  Claude: {CLAUDE_JSON} mcpServers; removed {removed} local-scope servers")  # noqa: T201  -- CLI report
    print(f"  Codex:  {CODEX_TOML} [mcp_servers.*]")  # noqa: T201  -- CLI report


if __name__ == "__main__":
    main()
