# Local overlays and secrets never enter the repo.
*.local
*.local.*
/.env
/.env.*
!/.env.example
*.pem
*.key

# Tool state
.venv/
__pycache__/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.copier-answers.yml
uv.lock.bak

# Editors and agents at the repo root (runtime state; config lives under home/ and
# template/project/, which is why these patterns are anchored with a leading slash)
/.claude/
/.codex/
/.cursor/
/.vscode/
/CLAUDE.local.md
/AGENTS.override.md

# macOS
.DS_Store
