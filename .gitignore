# Local overlays and secrets never enter the repo.
*.local
*.local.*
/.env
/.env.*
!/.env.example
*.pem
*.key

# Tool state
.venv/
__pycache__/
.ruff_cache/
.mypy_cache/
.copier-answers.yml
uv.lock.bak

# Editors and agents at the repo root (runtime state; config lives under home/ and
# template/project/, which is why these patterns are anchored with a leading slash)
/.claude/
/.codex/
/.cursor/
# Contents, not the directory: git does not descend into an excluded directory, so an
# ignored `/.vscode/` cannot have a file re-included beneath it. extensions.json is shared
# project metadata -- which extensions this repo's own shell, bats, TOML and Markdown need --
# while settings.json stays personal runtime state like the rest of this block.
/.vscode/*
!/.vscode/extensions.json
/CLAUDE.local.md
/AGENTS.override.md
/.reference-repos

# macOS
.DS_Store
