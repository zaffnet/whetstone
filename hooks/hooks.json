{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/ruff_format.sh\""
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/hooks/worktree_create.sh\"; if [ -r \"$f\" ]; then bash \"$f\"; else exit 0; fi",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
