{{- /* Asked once; answers live in ~/.config/chezmoi/chezmoi.toml. Non-interactive:
       chezmoi init --promptString name=...,email=...,src_dir=Desktop/src --promptChoice role=personal */ -}}
{{- $name := promptStringOnce . "name" "name" -}}
{{- $email := promptStringOnce . "email" "email" -}}
{{- $role := promptChoiceOnce . "role" "role" (list "personal" "work") "personal" -}}
{{- $srcDir := promptStringOnce . "src_dir" "src_dir" "Desktop/src" -}}

# Without this, a bare `chezmoi` command falls back to ~/.local/share/chezmoi, which does
# not exist when the repo is cloned somewhere else. It has to sit above [data], or TOML
# reads it as a key of the last table.
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
  # Git identity.
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  # personal | work. The work profile adds values for a machine that needs a proxy,
  # a private package index, or a branch prefix; they live in [data.work] below.
  role = {{ $role | quote }}
  # Where repositories live, relative to $HOME.
  src_dir = {{ $srcDir | quote }}

# Values for the work profile. Leave the table empty otherwise. This file is outside
# the repo, so nothing here is published.
#
#   [data.work]
#     openai_base_url = "https://llm-proxy.example.internal/v1"  # Codex: openai_base_url
#     aws_profile = "my-team-preprod"                             # MCP servers: AWS_PROFILE
#     pypi_index_url = "https://artifacts.example.internal/api/pypi/simple"
#     pypi_publish_url = "https://artifacts.example.internal/api/pypi"
#     branch_prefix = "yourhandle/"                               # Cursor git.branchPrefix, Codex git-branch-prefix
#     code_scan_command = "/opt/vendor/bin/code-scan"             # MCP server only this machine has
[data.work]

# `chezmoi update` pulls and then applies whatever the source directory's working tree
# holds, so a source that is anything other than released main applies unreleased work. A
# branch is the obvious way to get there, but not the only one: `git pull --ff-only origin
# main` succeeds without moving on a main that is merely ahead, and says nothing about
# uncommitted edits. So this asserts the condition that actually matters -- the tree is
# exactly origin/main -- and refuses otherwise rather than pulling and hoping.
[update]
  command = "sh"
  args = [
    "-c",
    '''
set -e
git fetch --quiet origin main
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "chezmoi source has uncommitted changes; refusing to apply it" >&2
  exit 1
fi
git pull --ff-only origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  echo "chezmoi source is not origin/main; refusing to apply it" >&2
  exit 1
fi
''',
  ]

[edit]
  command = "cursor"
  args = ["--wait"]
