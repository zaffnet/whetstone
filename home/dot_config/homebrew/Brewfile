# Installed by .chezmoiscripts/run_onchange_before_10-brew-bundle.sh.tmpl whenever this
# file changes. `just sync` diffs it against what brew has installed.
# Adopt apps that were installed by hand (iTerm2) instead of failing.
cask_args adopt: true

# Shell and terminal
brew "zsh-syntax-highlighting" # Fish-like syntax highlighting for zsh
brew "fzf"                     # Fuzzy finder
brew "tmux"                    # Terminal multiplexer
brew "tree"
brew "watch"
brew "htop"
brew "ripgrep"                 # grep, but fast (rg)
brew "jq"                      # JSON processor; hooks and scripts depend on it

# Git and GitHub
brew "gh"                      # GitHub CLI (gh stack extension installed by a run_once script)
brew "git-delta"               # Side-by-side diffs with syntax highlighting
brew "gitleaks"                # Secret scanning, pre-commit and CI
brew "commitlint"              # Conventional-commit linting
brew "gnupg"
brew "smimesign"               # S/MIME commit signing

# Dotfiles and task running
brew "chezmoi"
brew "just"
brew "bats-core"               # Shell test framework used by tests/

# Shell script quality
brew "shellcheck"
brew "shfmt"
brew "actionlint"              # GitHub Actions workflow linter

# Languages and runtimes
brew "uv"                      # Python packaging; also manages Python versions
brew "go"
brew "rbenv"
brew "ruby-build"
brew "ruby", link: false
brew "nvm"                     # Node version manager

# Documents and media
brew "pandoc"
brew "poppler"                 # pdftotext, pdftoppm
brew "tesseract"               # OCR
brew "ffmpeg"
# Homebrew ships hunspell with no dictionaries. It reads *.aff and *.dic from
# ~/Library/Spelling and /Library/Spelling, and macOS puts none there, so until a dictionary
# is installed `hunspell -D` lists no dictionary and every word reads as a miss.
brew "hunspell"                # Spell checker and morphological analyzer
# Grammar, which hunspell does not do at all: hunspell and cSpell both answer only
# "is this a word". harper-ls is the editor half and needs an extension installed by
# hand, the way Cursor itself does; harper-cli works from the shell with neither.
brew "harper"                  # Grammar checker (harper-ls, harper-cli)

# Cloud
brew "azure-cli"

# Apps
cask "iterm2"
# No `cask "cursor"`. Cursor is auto_updates, so brew never upgrades it -- the entry only
# recorded that it exists, and in exchange it could delete it. Adopting an existing
# /Applications/Cursor.app means modifying an app Homebrew did not place there, which
# macOS App Management refuses; the cask then rolls back by removing the app, and the
# failed script aborts the whole apply before a single dotfile is written. Install Cursor
# by hand (docs/new-machine.md); it keeps itself up to date.
cask "codex"                   # OpenAI Codex desktop app
cask "beekeeper-studio"        # SQL client
cask "dbeaver-community"
cask "caffeine"                # Keep the Mac awake
cask "maccy"                   # Clipboard manager
cask "font-fira-code"
cask "font-meslo-lg-nerd-font" # Powerlevel10k glyphs
cask "font-jetbrains-mono-nerd-font"

# Python CLIs kept outside any project (uv tool install)
uv "argcomplete"
uv "basedpyright"
uv "pyrefly"
uv "ruff"
uv "playwright"
uv "it2"                       # iTerm2 CLI

npm "corepack"
npm "mermaid-filter"
