# Apps
cask "iterm2"
# No `cask "cursor"`: adopting the existing /Applications/Cursor.app breaks the apply.
# Install Cursor by hand; it self-updates.
cask "codex"                   # OpenAI Codex desktop app
cask "beekeeper-studio"        # SQL client
cask "dbeaver-community"
cask "caffeine"                # Keep the Mac awake
cask "maccy"                   # Clipboard manager
# Adopted from an existing install: brew takes over the app in place rather than refusing,
# because of `cask_args adopt: true` above.
cask "gitkraken"
cask "whatsapp"

# No cask for Docker Desktop, Google Chrome, Claude, ChatGPT, or GitHub Desktop. Each one
# needs `sudo` to finish -- moving an app into /Applications, a recursive chmod, replacing a
# binary under /usr/local/bin -- and this file is installed from a non-interactive script,
# where the password prompt cannot be answered. `brew bundle` then exits 1 and fails the
# apply. Install them by hand; all five keep themselves up to date. Claude, ChatGPT and
# GitHub Desktop are in ~/Applications on this machine, which is why brew wants to move
# them.

cask "font-fira-code"
cask "font-meslo-lg-nerd-font" # Powerlevel10k glyphs
cask "font-jetbrains-mono-nerd-font"

