#!/usr/bin/env bash
set -euo pipefail

if ! command -v uv >/dev/null; then
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x $brew_bin ]]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
fi

sync="{{ .chezmoi.homeDir }}/.agents/bin/sync-mcp"
if [[ ! -x $sync ]]; then
  echo "sync-mcp: not installed, skipping" >&2
elif [[ ! -f "{{ .chezmoi.homeDir }}/.claude.json" ]]; then
  echo "sync-mcp: ~/.claude.json absent (Claude Code not run yet), skipping" >&2
elif ! command -v uv >/dev/null; then
  echo "sync-mcp: uv not on PATH, skipping" >&2
else
  uv run --no-project --python 3.12 python "$sync"
fi

if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
  if ! gh extension list 2>/dev/null | grep -q 'github/gh-stack'; then
    gh extension install github/gh-stack || echo "sync-mcp: gh-stack install failed" >&2
  fi
fi
