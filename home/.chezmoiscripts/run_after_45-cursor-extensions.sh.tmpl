#!/usr/bin/env bash
set -euo pipefail

list="{{ .chezmoi.homeDir }}/.cursor/extensions.txt"
cursor_bin=""
for candidate in \
  "{{ .chezmoi.homeDir }}/Applications/Cursor.app/Contents/Resources/app/bin/cursor" \
  "/Applications/Cursor.app/Contents/Resources/app/bin/cursor"; do
  if [[ -x $candidate ]]; then
    cursor_bin="$candidate"
    break
  fi
done
if [[ -z $cursor_bin ]]; then
  echo "cursor-extensions: Cursor not installed, skipping" >&2
  exit 0
fi

if [[ ! -r $list ]]; then
  echo "cursor-extensions: $list is missing, nothing to install from" >&2
  exit 1
fi

# An empty list from a failed call would make every extension look absent and force a
# reinstall of all of them, so treat the failure as fatal instead.
if ! installed="$("$cursor_bin" --list-extensions 2>/dev/null)"; then
  echo "cursor-extensions: could not list installed extensions" >&2
  exit 1
fi
status=0
while read -r ext || [[ -n $ext ]]; do
  [[ -z $ext || $ext == \#* ]] && continue
  grep -qxFi -- "$ext" <<<"$installed" && continue
  "$cursor_bin" --install-extension "$ext" --force >/dev/null || {
    echo "cursor-extensions: failed to install $ext" >&2
    status=1
  }
done <"$list"
exit "$status"
