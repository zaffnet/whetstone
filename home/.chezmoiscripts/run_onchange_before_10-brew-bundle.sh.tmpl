#!/usr/bin/env bash
# Installs Homebrew if missing, then converges on the Brewfile. The Brewfile is inlined
# here at render time, so this works on the first apply (before any file is written)
# and re-runs whenever the Brewfile changes (`run_onchange_` hashes the rendered script).
set -euo pipefail

if ! command -v brew >/dev/null; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

brew bundle install --no-upgrade --file=/dev/stdin <<'BREWFILE'
{{ include "dot_config/homebrew/Brewfile" -}}
BREWFILE
