#!/usr/bin/env bash
# Installs the third-party agent skills listed in ~/.agents/skills.txt (npx skills add, global
# scope) and the gh extension the prompt relies on. Hand-written skills are linked by
# 25-link-skills.sh. Re-runs when skills.txt changes.
# skills.txt hash: {{ include "dot_agents/skills.txt" | sha256sum }}
set -euo pipefail

list="{{ .chezmoi.homeDir }}/.agents/skills.txt"
if command -v npx >/dev/null; then
  while read -r repo skills; do
    [[ -z $repo || $repo == \#* ]] && continue
    if [[ -n $skills ]]; then
      # One -s flag per skill; the tool does not split a comma list.
      flags=()
      for skill in $skills; do flags+=(-s "$skill"); done
      npx -y skills@latest add "$repo" -g -y -a claude-code "${flags[@]}" \
        || echo "skills: failed to add $repo" >&2
    else
      npx -y skills@latest add "$repo" -g -y -a claude-code -s '*' \
        || echo "skills: failed to add $repo" >&2
    fi
  done <"$list"
else
  echo "skills: npx not found, skipping third-party skills" >&2
fi

if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
  gh extension list 2>/dev/null | grep -q 'github/gh-stack' || gh extension install github/gh-stack || true
fi
