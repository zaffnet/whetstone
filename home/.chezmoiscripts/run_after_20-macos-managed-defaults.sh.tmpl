#!/usr/bin/env bash
set -euo pipefail

managed_finder_settings=(
  "ShowPathbar|-bool|true"
  "AppleShowAllFiles|-bool|true"
  "FXDefaultSearchScope|-string|SCcf"
  "NewWindowTarget|-string|PfAF"
  "FXRemoveOldTrashItems|-bool|true"
)
managed_dock_settings=(
  "autohide|-bool|true"
  "show-recents|-bool|false"
  "expose-group-apps|-bool|true"
  "tilesize|-int|67"
)
managed_iterm2_settings=(
  "FocusFollowsMouse|-bool|true"
  "AggressiveFocusFollowsMouse|-bool|true"
  "FocusNewSplitPaneWithFocusFollowsMouse|-bool|true"
  "DimInactiveSplitPanes|-bool|true"
  "SplitPaneDimmingAmount|-float|0.2518520555218447"
  "DimBackgroundWindows|-bool|false"
  "Selection Respects Soft Boundaries|-bool|true"
  "CopySelection|-bool|false"
  "CopyLastNewline|-bool|true"
  "ClickToSelectCommand|-bool|false"
  "EnableAPIServer|-bool|true"
  "HideActivityIndicator|-bool|false"
  "ShowFullScreenTabBar|-bool|false"
  "Default Bookmark Guid|-string|whetstone-default"
)

apply_managed_defaults() {
  local domain="$1"
  shift
  local settings=(${@+"$@"})

  local setting key type value rest
  for setting in ${settings[@]+"${settings[@]}"}; do
    key="${setting%%|*}"
    rest="${setting#*|}"
    type="${rest%%|*}"
    value="${rest#*|}"
    defaults write "$domain" "$key" "$type" "$value"
  done
}

apply_managed_defaults com.apple.finder \
  ${managed_finder_settings[@]+"${managed_finder_settings[@]}"}
apply_managed_defaults com.apple.dock \
  ${managed_dock_settings[@]+"${managed_dock_settings[@]}"}
killall Finder Dock 2>/dev/null || true

# Exit 1 is "no match"; anything else means pgrep could not answer, and writing then
# would risk a running iTerm2 overwriting these settings when it quits.
iterm2_pgrep=0
pgrep -qf iTerm.app || iterm2_pgrep=$?
if [ "$iterm2_pgrep" -eq 0 ]; then
  printf 'iTerm2 settings skipped: it is running, and would overwrite them on quit.\n' >&2
  printf 'Quit iTerm2, then re-apply from Terminal.app or over ssh.\n' >&2
  exit 0
elif [ "$iterm2_pgrep" -ne 1 ]; then
  printf 'could not tell whether iTerm2 is running: pgrep exited %s.\n' "$iterm2_pgrep" >&2
  printf 'No iTerm2 setting was written.\n' >&2
  exit 1
fi

apply_managed_defaults com.googlecode.iterm2 \
  ${managed_iterm2_settings[@]+"${managed_iterm2_settings[@]}"}

iterm2_workgroups_b64="$(
  cat <<'WORKGROUPS_B64'
{{ include ".chezmoitemplates/iterm2-workgroups.json" | b64enc }}
WORKGROUPS_B64
)"

iterm2_plist="$HOME/Library/Preferences/com.googlecode.iterm2.plist"
plutil -replace Workgroups -data "$iterm2_workgroups_b64" "$iterm2_plist"

iterm2_workgroups_written=""
if ! iterm2_workgroups_written="$(
  plutil -extract Workgroups raw -o - "$iterm2_plist" 2>/dev/null | tr -d '\n'
)" || [ "$iterm2_workgroups_written" != "$(printf '%s' "$iterm2_workgroups_b64" | tr -d '\n')" ]; then
  printf 'failed to write Workgroups into %s\n' "$iterm2_plist" >&2
  exit 1
fi

killall cfprefsd 2>/dev/null || true
