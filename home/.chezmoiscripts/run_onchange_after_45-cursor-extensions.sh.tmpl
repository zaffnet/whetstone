#!/usr/bin/env bash
# Installs the Cursor extensions listed in ~/.cursor/extensions.txt. Re-runs when the list
# changes.
# extensions.txt hash: {{ include "dot_cursor/extensions.txt" | sha256sum }}
set -euo pipefail

list="{{ .chezmoi.homeDir }}/.cursor/extensions.txt"
# Cursor is installed by hand rather than by the Brewfile, so the CLI is absent on a machine
# where that step has not happened yet.
cursor_bin="{{ .chezmoi.homeDir }}/Applications/Cursor.app/Contents/Resources/app/bin/cursor"
if [[ ! -x $cursor_bin ]]; then
  echo "cursor-extensions: Cursor not installed, skipping" >&2
  exit 0
fi

installed="$("$cursor_bin" --list-extensions 2>/dev/null || true)"
while read -r ext || [[ -n $ext ]]; do
  [[ -z $ext || $ext == \#* ]] && continue
  grep -qxFi -- "$ext" <<<"$installed" && continue
  "$cursor_bin" --install-extension "$ext" --force >/dev/null \
    || echo "cursor-extensions: failed to install $ext" >&2
done <"$list"
