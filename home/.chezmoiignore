{{ if and (ne (env "CI") "") (ne (env "CI") "0") (ne (env "CI") "false") -}}
# CI applies the tree into a throwaway HOME; skip installs that need network or a GUI.
# Compared, not tested for presence: every non-empty string is true in a template, so
# `CI=0` in a shell would have skipped these on a real machine.
.chezmoiscripts/05-oh-my-zsh.sh
.chezmoiscripts/10-brew-bundle.sh
.chezmoiscripts/20-macos-defaults.sh
.chezmoiscripts/20-macos-managed-defaults.sh
.chezmoiscripts/30-agent-skills.sh
.chezmoiscripts/40-sync-mcp.sh
# Externals, for the same reason: a CI apply is timed in macos.yml and should not wait on
# raw.githubusercontent. The declaration is asserted in tests/home.bats instead of the files.
Library/Spelling/en_US.aff
Library/Spelling/en_US.dic
Library/Spelling/en_CA.aff
Library/Spelling/en_CA.dic
{{- end }}

{{ if eq .role "work" -}}
# Some machines have tooling that rewrites ~/.gitconfig (signing key, x509 program) on
# every git call, which would show as permanent drift. Under the work profile the file is
# kept by hand; ~/.gitconfig.local still applies.
.gitconfig
{{- end }}
