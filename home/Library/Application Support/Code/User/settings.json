{
  "workbench.colorTheme": "Light 2026",
  "workbench.colorCustomizations": {
    "terminal.background": "#F5F2EE",
    "terminal.foreground": "#333333",
    "terminalCursor.foreground": "#D33682",
    "terminal.border": "#E0DDD8",
    "terminal.ansiBlack": "#073642",
    "terminal.ansiRed": "#DC322F",
    "terminal.ansiGreen": "#859900",
    "terminal.ansiYellow": "#B58900",
    "terminal.ansiBlue": "#268BD2",
    "terminal.ansiMagenta": "#D33682",
    "terminal.ansiCyan": "#2AA198",
    "terminal.ansiWhite": "#EEE8D5",
    "terminal.ansiBrightBlack": "#002B36",
    "terminal.ansiBrightRed": "#CB4B16",
    "terminal.ansiBrightGreen": "#586E75",
    "terminal.ansiBrightYellow": "#657B83",
    "terminal.ansiBrightBlue": "#839496",
    "terminal.ansiBrightMagenta": "#6C71C4",
    "terminal.ansiBrightCyan": "#93A1A1",
    "terminal.ansiBrightWhite": "#FDF6E3"
  },
  "terminal.integrated.scrollback": 10000000,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontWeight": "400",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.environmentVariables": [],
  "github.copilot.nextEditSuggestions.enabled": true,
  "files.autoSaveDelay": 10000,
  "files.autoSave": "afterDelay",
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.anthropic.tools.websearch.maxUses": 20,
  "github.copilot.chat.anthropic.contextEditing.enabled": true,
  "editor.defaultFormatter": "Anthropic.claude-code",
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "bash",
      "args": [
        "-l"
      ],
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "/bin/zsh",
      "args": [
        "-l"
      ]
    },
    "fish": {
      "path": "fish",
      "args": [
        "-l"
      ]
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux"
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.lineHeight": 1.0,
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.gpuAcceleration": "on",
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "cSpell.userWords": [
    "Dataclass",
    "Pydantic",
    "uvicorn"
  ],
  "chat.mcp.discovery.enabled": {
    "claude-desktop": false,
    "windsurf": false,
    "cursor-global": false,
    "cursor-workspace": false
  },
  "python.analysis.typeCheckingMode": "standard",
  "terminal.integrated.mouseWheelScrollSensitivity": 3
}
