#!/usr/bin/env bash
# chezmoi modify script: receives the current ~/.codex/config.toml on stdin and prints the
# new file. Ownership is per table, not per key: a table the template declares is rewritten
# whole, and every other table belongs to another writer (Codex itself, bin/sync-mcp) and is
# carried over verbatim, so an apply never drops Codex's MCP servers, project trust
# decisions, or bundled plugins. Whole-table ownership is what makes a deletion work --
# drop a key from the template and it leaves the machine on the next apply, which a
# key-by-key merge could not do, because the deleted key would read as undeclared and be
# preserved forever.
set -euo pipefail

managed=$(
  cat <<'MANAGED'
{{ template "codex-config.toml.tmpl" . }}
MANAGED
)

current=$(cat)

MANAGED="$managed" CURRENT="$current" python3 - <<'PY'
import os
import re
import sys

MARKER = "# --- preserved sections (owned by Codex and bin/sync-mcp; chezmoi keeps them as-is) ---"

managed = os.environ["MANAGED"].rstrip("\n")
current = os.environ["CURRENT"]

# Byte for byte the TABLE_HEADER in bin/sync-mcp; see the note there. A key part is a run
# of ordinary characters or a whole quoted string, so a ] or a # inside a quoted table name
# is content and the table is not mistaken for ordinary lines and dropped.
HEADER = re.compile(r"^[ \t]*\[\[?((?:[^]\"']|\"(?:[^\"\\]|\\.)*\"|'[^']*')+)\]\]?\s*(?:#.*)?$")
BARE_KEY = re.compile(r'''^\s*("[^"]+"|'[^']+'|[A-Za-z0-9_.-]+)\s*=''')


# TOML's escapes inside a basic string. A table name carrying one is rare, but decoding
# half of them would put us back where comparing the raw text was: two spellings of one
# name reading as two names.
ESCAPES = {"b": "\b", "t": "\t", "n": "\n", "f": "\f", "r": "\r", '"': '"', "\\": "\\"}


def unquote(part):
    """One key part as the string TOML reads it: 'tui', "tui", and tui are all tui."""
    if len(part) > 1 and part[0] == part[-1] == "'":
        return part[1:-1]  # a literal string has no escapes
    if not (len(part) > 1 and part[0] == part[-1] == '"'):
        return part
    body, out, i = part[1:-1], [], 0
    while i < len(body):
        if body[i] == "\\" and i + 1 < len(body):
            after = body[i + 1]
            if after in ESCAPES:
                out.append(ESCAPES[after])
                i += 2
                continue
            if after in "uU":
                width = 4 if after == "u" else 8
                digits = body[i + 2 : i + 2 + width]
                if len(digits) == width:
                    out.append(chr(int(digits, 16)))
                    i += 2 + width
                    continue
        out.append(body[i])
        i += 1
    return "".join(out)


def key_path(name):
    """A key as the parts TOML resolves it to, so ["tui"] and [tui] are one table.

    Compared as text they are two, and the script would preserve the live spelling while
    the template emits its own -- one table declared twice, which is not valid TOML.
    Splitting is quote-aware: a dot inside quotes is part of the name, not a separator.
    """
    parts, part, quote, escaped = [], "", "", False
    for char in name:
        if quote:
            part += char
            if escaped:
                escaped = False
            elif quote == '"' and char == "\\":
                escaped = True
            elif char == quote:
                quote = ""
        elif char in "\"'":
            quote = char
            part += char
        elif char == ".":
            parts.append(part)
            part = ""
        else:
            part += char
    parts.append(part)
    return tuple(unquote(p.strip()) for p in parts)


def table_name(line):
    match = HEADER.match(line)
    return key_path(match.group(1).strip()) if match else None


def key_name(line):
    match = BARE_KEY.match(line)
    # "notify" and notify are the same key.
    return key_path(match.group(1)) if match else None


def scan_line(line, opener, depth):
    """The multiline delimiter and bracket depth still open at the end of `line`.

    A header or a key is only itself at the lexical top level: outside a multiline string
    and outside an array. Both ways of getting that wrong ended the same, with an apply
    writing a ~/.codex/config.toml that does not parse -- a `[tui]` line inside a preserved
    value read as the managed table and dropped the rest of the string, and a `["tui"]`
    element on its own line read as a table and orphaned the `custom = [` above it. There
    is no guard downstream to catch either: system python3 on macOS is 3.9, no tomllib.
    """
    index = 0
    length = len(line)
    while index < length:
        if opener is not None:
            # A basic string keeps its escapes, so a backslash consumes what follows it.
            # Without that, the three quotes in `\"""` -- an escaped quote and two plain
            # ones, which is how TOML spells a literal `"""` inside a multiline string --
            # read as the closing delimiter. A literal string has no escapes.
            if opener == '"""' and line[index] == "\\":
                index += 2
                continue
            if line.startswith(opener, index):
                opener = None
                index += 3
            else:
                index += 1
            continue
        three = line[index : index + 3]
        if three in ('"""', "'''"):
            opener = three
            index += 3
            continue
        char = line[index]
        if char == "#":
            break
        if char in "\"'":
            index += 1
            while index < length and line[index] != char:
                index += 2 if char == '"' and line[index] == "\\" else 1
            index += 1
            continue
        if char in "[{":
            depth += 1
        elif char in "]}" and depth > 0:
            depth -= 1
        index += 1
    return opener, depth


def headers(lines):
    """Each line with its table name and whether it starts at the lexical top level.

    A header line balances its own brackets, so scanning it leaves the depth where it was.
    """
    opener = None
    depth = 0
    for line in lines:
        at_top = opener is None and depth == 0
        yield line, (table_name(line) if at_top else None), at_top
        opener, depth = scan_line(line, opener, depth)


# What the template declares. A table it declares wins outright. A table merely nested
# under one does not: `[tui.model_availability_nux]` is Codex's own state, the old KEEP
# allowlist named it for that reason, and the template declaring `[tui]` says nothing
# about it. Only an exact match is managed; everything else is preserved.
managed_lines = managed.splitlines()
managed_headers = list(headers(managed_lines))
first_table = next(
    (i for i, (_, name, _) in enumerate(managed_headers) if name), len(managed_lines)
)
managed_tables = {name for _, name, _ in managed_headers if name}
managed_keys = {name for l in managed_lines[:first_table] if (name := key_name(l))}

kept_keys: list[str] = []
kept_tables: list[str] = []
block: list[str] = []
keep_block = False
in_preamble = True
keep_key = False


def flush() -> None:
    if keep_block and block:
        kept_tables.extend(block)
        if block[-1].strip():
            kept_tables.append("")


for line, name, at_top in headers(current.splitlines()):
    if line.strip() == MARKER:
        continue
    if name is not None:
        flush()
        block = []
        in_preamble = False
        keep_block = name not in managed_tables
    if in_preamble:
        # Only another key or a table header ends a capture. A blank or comment line can
        # sit inside a multiline value, so it has to be captured, not treated as the end.
        # Only at the top level: a `model = "inside"` line within a preserved multiline
        # value is that value's text, not the managed key, and reading it as the key
        # dropped the line and the closing delimiter with it.
        key = key_name(line) if at_top else None
        if key is not None:
            keep_key = key not in managed_keys
        if keep_key:
            kept_keys.append(line)
        continue
    block.append(line)
flush()

# A preserved bare key has to land above the first table, or TOML reparents it into
# whichever table it happens to follow. Capture runs to the next key, so it can pick up
# blank lines that trail the last one.
while kept_keys and not kept_keys[-1].strip():
    kept_keys.pop()
preamble = managed_lines[:first_table] + (kept_keys + [""] if kept_keys else [])
out = "\n".join(preamble + managed_lines[first_table:]) + "\n"
if kept_tables:
    out += "\n" + MARKER + "\n\n" + "\n".join(kept_tables).rstrip("\n") + "\n"
sys.stdout.write(out)
PY
