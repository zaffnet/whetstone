#!/usr/bin/env bash
# chezmoi modify script: receives the current ~/.codex/config.toml on stdin and prints the
# new file. Ownership is per table, not per key: a table the template declares is rewritten
# whole, and every other table belongs to another writer (Codex itself, bin/sync-mcp) and is
# carried over verbatim, so an apply never drops Codex's MCP servers, project trust
# decisions, or bundled plugins. Whole-table ownership is what makes a deletion work --
# drop a key from the template and it leaves the machine on the next apply, which a
# key-by-key merge could not do, because the deleted key would read as undeclared and be
# preserved forever.
set -euo pipefail

managed=$(
  cat <<'MANAGED'
{{ template "codex-config.toml.tmpl" . }}
MANAGED
)

current=$(cat)

MANAGED="$managed" CURRENT="$current" python3 - <<'PY'
import os
import re
import sys

MARKER = "# --- preserved sections (owned by Codex and bin/sync-mcp; chezmoi keeps them as-is) ---"

managed = os.environ["MANAGED"].rstrip("\n")
current = os.environ["CURRENT"]

# Byte for byte the TABLE_HEADER in bin/sync-mcp; see the note there. A key part is a run
# of ordinary characters or a whole quoted string, so a ] or a # inside a quoted table name
# is content and the table is not mistaken for ordinary lines and dropped.
HEADER = re.compile(r"^[ \t]*\[\[?((?:[^]\"']|\"(?:[^\"\\]|\\.)*\"|'[^']*')+)\]\]?\s*(?:#.*)?$")
BARE_KEY = re.compile(r'''^\s*("[^"]+"|'[^']+'|[A-Za-z0-9_.-]+)\s*=''')


def table_name(line):
    match = HEADER.match(line)
    return match.group(1).strip() if match else None


def key_name(line):
    match = BARE_KEY.match(line)
    # "notify" and notify are the same key.
    return match.group(1).strip("\"'") if match else None


def close_multiline(line, opener):
    """The multiline delimiter still open at the end of `line`, or None.

    A table header is only a header outside a multiline string. Without this, a `[tui]`
    line inside a preserved value reads as the managed [tui] table: that block is dropped
    out of the middle of the string, the value is left unterminated, and the apply writes
    a ~/.codex/config.toml that does not parse. There is no guard downstream to catch it,
    and there cannot easily be one -- system python3 on macOS is 3.9, which has no tomllib.
    """
    index = 0
    length = len(line)
    while index < length:
        if opener is not None:
            if line.startswith(opener, index):
                opener = None
                index += 3
            else:
                index += 1
            continue
        three = line[index : index + 3]
        if three in ('"""', "'''"):
            opener = three
            index += 3
            continue
        char = line[index]
        if char == "#":
            break
        if char in "\"'":
            index += 1
            while index < length and line[index] != char:
                index += 2 if char == '"' and line[index] == "\\" else 1
            index += 1
            continue
        index += 1
    return opener


def headers(lines):
    """Each line with its table name, or None where it is not a header at the top level."""
    opener = None
    for line in lines:
        yield line, (None if opener is not None else table_name(line))
        opener = close_multiline(line, opener)


# What the template declares. A table it declares wins outright. A table merely nested
# under one does not: `[tui.model_availability_nux]` is Codex's own state, the old KEEP
# allowlist named it for that reason, and the template declaring `[tui]` says nothing
# about it. Only an exact match is managed; everything else is preserved.
managed_lines = managed.splitlines()
managed_headers = list(headers(managed_lines))
first_table = next(
    (i for i, (_, name) in enumerate(managed_headers) if name), len(managed_lines)
)
managed_tables = {name for _, name in managed_headers if name}
managed_keys = {name for l in managed_lines[:first_table] if (name := key_name(l))}

kept_keys: list[str] = []
kept_tables: list[str] = []
block: list[str] = []
keep_block = False
in_preamble = True
keep_key = False


def flush() -> None:
    if keep_block and block:
        kept_tables.extend(block)
        if block[-1].strip():
            kept_tables.append("")


for line, name in headers(current.splitlines()):
    if line.strip() == MARKER:
        continue
    if name is not None:
        flush()
        block = []
        in_preamble = False
        keep_block = name not in managed_tables
    if in_preamble:
        # Only another key or a table header ends a capture. A blank or comment line can
        # sit inside a multiline value, so it has to be captured, not treated as the end.
        key = key_name(line)
        if key is not None:
            keep_key = key not in managed_keys
        if keep_key:
            kept_keys.append(line)
        continue
    block.append(line)
flush()

# A preserved bare key has to land above the first table, or TOML reparents it into
# whichever table it happens to follow. Capture runs to the next key, so it can pick up
# blank lines that trail the last one.
while kept_keys and not kept_keys[-1].strip():
    kept_keys.pop()
preamble = managed_lines[:first_table] + (kept_keys + [""] if kept_keys else [])
out = "\n".join(preamble + managed_lines[first_table:]) + "\n"
if kept_tables:
    out += "\n" + MARKER + "\n\n" + "\n".join(kept_tables).rstrip("\n") + "\n"
sys.stdout.write(out)
PY
