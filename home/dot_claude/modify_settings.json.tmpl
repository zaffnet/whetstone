#!/usr/bin/env bash
# chezmoi modify script for ~/.claude/settings.json: receives the current file on stdin and
# prints the new one. Ownership is per top-level key. A key the template declares is
# rewritten from it; every other key belongs to Claude Code and is carried over, so an apply
# never undoes a choice made inside the product.
#
# RUNTIME exempts one key by name: `model` is picked per machine in the model picker, so the
# template's value seeds a machine that has none and then steps aside. Every other key the
# template names, it owns.
#
# A key dropped from the template stops being declared, so it is carried over as Claude
# Code's instead of leaving the machine. Removing a setting is two steps -- delete it from
# the template, then delete it once from the live file.
set -euo pipefail
current=$(cat)
MANAGED=$(
  cat <<'MANAGED'
{{ template "claude-settings.json" . }}
MANAGED
)
CURRENT="$current" MANAGED="$MANAGED" python3 - <<'PY'
import json
import os
import sys

RUNTIME = ("model",)
managed = json.loads(os.environ["MANAGED"])
try:
    current = json.loads(os.environ["CURRENT"] or "{}")
except json.JSONDecodeError:
    print(  # noqa: T201  -- surfaces in `chezmoi apply` output
        "settings.json did not parse; undeclared keys not preserved",
        file=sys.stderr,
    )
    current = {}

for key in RUNTIME:
    if key in current:
        managed[key] = current[key]
# Kept after the declared keys, so `chezmoi diff` shows what the product added rather than
# interleaving it. Named on stderr because JSON has no comment to label the block with.
undeclared = [key for key in current if key not in managed]
for key in undeclared:
    managed[key] = current[key]
if undeclared:
    print(  # noqa: T201  -- surfaces in `chezmoi apply` output
        f"settings.json: carried over undeclared keys: {', '.join(undeclared)}",
        file=sys.stderr,
    )
print(json.dumps(managed, indent=2))  # noqa: T201  -- this is the script's output
PY
