# Managed by chezmoi from {{ .chezmoi.workingTree }}. Edit there, then `chezmoi apply`.
# Machine-specific additions go in ~/.zshrc.local (sourced at the bottom, never committed).

# Powerlevel10k instant prompt. Must stay near the top; anything that prompts
# for input (passwords, [y/n]) goes above it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# whetstone's own scripts. {{ .chezmoi.sourceDir }} is the source checkout's home/, so a
# clone anywhere works. It must be the worktree [update] in .chezmoi.toml.tmpl insists on,
# which is released main and nothing else: this line is read on every shell start rather
# than at apply time, so anywhere else `git checkout` alone would change what these scripts
# do in every open terminal.
export PATH="{{ .chezmoi.sourceDir | dir }}/bin:$PATH"

# Language runtimes
if command -v rbenv >/dev/null; then
  export PATH="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/ruby/bin:$PATH"
  eval "$(rbenv init - zsh)"
fi
# Homebrew's nvm formula keeps nvm.sh under its own prefix; a standard install puts it in
# $NVM_DIR. Either way $NVM_DIR is where versions go.
export NVM_DIR="$HOME/.nvm"
for nvm_sh in "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm/nvm.sh" "$NVM_DIR/nvm.sh"; do
  if [ -s "$nvm_sh" ]; then
    \. "$nvm_sh"
    break
  fi
done
unset nvm_sh

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Try personal history first, then Zsh's current completion candidates.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=40

plugins=(
  git
  zsh-autosuggestions
)

# Case-insensitive completion with grouped, labelled candidates.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' menu no

source "$ZSH/oh-my-zsh.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

command -v codex >/dev/null && eval "$(codex completion zsh)"

# Ctrl-F accepts the whole ghost suggestion.
bindkey '^F' autosuggest-accept

# Powerlevel10k segment: the open PR number for the current branch, refreshed
# in the background at most once a minute per branch. ~/.p10k.zsh lists `ghpr`
# in POWERLEVEL9K_LEFT_PROMPT_ELEMENTS.
zmodload zsh/datetime
typeset -gA GHPR_REFRESH_STARTED

_refresh_ghpr_cache() {
  emulate -L zsh

  local repository_root=$1
  local branch=$2
  local cache_file=$3
  local cache_directory=${cache_file:h}
  local temporary_cache_file="${cache_file}.${$}.${RANDOM}.tmp"

  (
    builtin cd -q -- "$repository_root" || return

    local pr_number
    pr_number=$(
      command gh pr list \
        --head "$branch" \
        --state open \
        --limit 1 \
        --json number \
        --jq '.[0].number // empty'
    ) || return

    command mkdir -p -- "$cache_directory" || return
    printf '%s\t%s\n' "$EPOCHSECONDS" "$pr_number" >"$temporary_cache_file" || return
    command mv -f -- "$temporary_cache_file" "$cache_file"
  ) </dev/null &>/dev/null &|
}

prompt_ghpr() {
  emulate -L zsh

  local -a git_context
  git_context=("${(@f)$(command git rev-parse --show-toplevel --abbrev-ref HEAD 2>/dev/null)}") || return
  ((${#git_context} == 2)) || return

  local repository_root=$git_context[1]
  local branch=$git_context[2]
  [[ "$branch" != HEAD ]] || return

  local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-ghpr${repository_root}/${branch}"
  local checked_at=0
  local pr_number=

  if [[ -r "$cache_file" ]]; then
    IFS=$'\t' read -r checked_at pr_number <"$cache_file"
    [[ "$checked_at" == <-> ]] || checked_at=0
    [[ "$pr_number" == <-> ]] || pr_number=
  fi

  local refresh_started=${GHPR_REFRESH_STARTED[$cache_file]:-0}
  if ((EPOCHSECONDS - checked_at >= 60 && EPOCHSECONDS - refresh_started >= 60)); then
    GHPR_REFRESH_STARTED[$cache_file]=$EPOCHSECONDS
    _refresh_ghpr_cache "$repository_root" "$branch" "$cache_file"
  fi

  [[ -n "$pr_number" ]] || return
  p10k segment -f 6 -t "PR #${pr_number}"
}

export EDITOR="cursor -w"
export CLAUDE_CODE_NO_FLICKER=1
export CLAUDE_CODE_SCROLL_SPEED=3
# Here rather than in ~/.claude/settings.json, which carries no `env` block. Not
# ~/.zsh_secrets either: that file is unmanaged on purpose, so anything in it reaches one
# machine and no other, and none of these is a secret.
export MAX_THINKING_TOKENS=0
export CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=1
export COLORTERM=truecolor

alias python=python3

test -e ~/.iterm2_shell_integration.zsh && source ~/.iterm2_shell_integration.zsh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# API keys and tokens. Copy home/dot_zsh_secrets.example from the chezmoi source; never commit.
[ -s "$HOME/.zsh_secrets" ] && source "$HOME/.zsh_secrets"

# Machine-local overrides (proxies, CA bundles, extra CLIs). Never commit.
[ -s "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# Must be sourced last.
[[ -r "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] \
  && source "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
