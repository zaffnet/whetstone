# Copy to ~/.zsh_secrets (chmod 600) and fill in. Sourced by .zshrc; never committed.
# Every tool reads these from the environment, so no key needs to live in a tool's
# own config file.

# export ANTHROPIC_API_KEY=
# export ANTHROPIC_BASE_URL=         # only when routing through a gateway rather than
#                                   # the Anthropic API; ANTHROPIC_AUTH_TOKEN is the
#                                   # gateway's token and replaces ANTHROPIC_API_KEY.
# export ANTHROPIC_AUTH_TOKEN=
# export ANTHROPIC_MODEL=            # pins a model for tools that read it from the
#                                   # environment; leave unset to take their default.
# export OPENAI_API_KEY=
# export OPENAI_BASE_URL=            # only when routing through a proxy; include the
#                                   # /v1 suffix, the same value as openai_base_url
#                                   # in [data.work]. The bin/ Codex scripts read the
#                                   # Codex config first, so a mismatch shows up in
#                                   # other tools instead of in them.
# export GITHUB_PERSONAL_ACCESS_TOKEN=
# export HF_TOKEN=
# export BRAINTRUST_API_KEY=
# export UV_PUBLISH_USERNAME=
# export UV_PUBLISH_PASSWORD=
# export CODEX_API_KEY=            # the Codex CLI reads this rather than OPENAI_API_KEY,
#                                   # so both are set when the two point at different
#                                   # gateways.
# export CODEX_GITHUB_PERSONAL_ACCESS_TOKEN=
#                                   # a second GitHub token scoped for Codex, kept apart
#                                   # from GITHUB_PERSONAL_ACCESS_TOKEN.
# export LANGFUSE_PUBLIC_KEY=
# export LANGFUSE_SECRET_KEY=
# export LANGFUSE_BASE_URL=          # the Langfuse instance to trace to; unset means the
#                                   # public cloud.
# export APP_BRAINTRUST_API_KEY=     # a per-application Braintrust key, separate from
#                                   # BRAINTRUST_API_KEY so one project's traces cannot
#                                   # be written with the personal key.
# export APP_BRAINTRUST_API_URL=
# export APP_BRAINTRUST_PROJECT=
# export CAPSOLVER_API_KEY=          # captcha-solving service, used by browser automation.
# export BEARER_TOKEN=               # generic bearer token read by ad-hoc API scripts.
# export WORKSPACE_ID=               # identifiers a work API expects alongside its token;
# export ASSET_ID=                   # both are account-specific, not secret on their own.
# export ADO_PAT=                    # Azure DevOps personal access token.
# export UV_INDEX_TR1_JFROG_USERNAME=
# export UV_INDEX_TR1_JFROG_PASSWORD=
#                                   # credentials for a private Artifactory Python index;
#                                   # the index URL itself is pypi_index_url in
#                                   # [data.work].
