# Copy to ~/.zsh_secrets (chmod 600) and fill in. Sourced by .zshrc; never committed.
# Every tool reads these from the environment, so no key needs to live in a tool's
# own config file (see docs/decisions/0008-secrets-via-environment.md).

# export ANTHROPIC_API_KEY=
# export OPENAI_API_KEY=
# export OPENAI_BASE_URL=            # only when routing through a proxy; include the
#                                   # /v1 suffix, the same value as openai_base_url
#                                   # in [data.work]. The bin/ Codex scripts read the
#                                   # Codex config first, so a mismatch shows up in
#                                   # other tools instead of in them.
# export GITHUB_PERSONAL_ACCESS_TOKEN=
# export HF_TOKEN=
# export BRAINTRUST_API_KEY=
# export UV_PUBLISH_USERNAME=
# export UV_PUBLISH_PASSWORD=
