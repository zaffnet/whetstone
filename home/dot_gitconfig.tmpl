[user]
	name = {{ .name }}
	email = {{ .email }}
[pull]
	rebase = true
[core]
	pager = delta
	excludesFile = ~/.config/git/ignore
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	line-numbers = true
	navigate = true
	hyperlinks = true
	wrap-max-lines = unlimited
	wrap-left-symbol = " "
	wrap-right-symbol = " "
	wrap-right-prefix-symbol = " "
	wrap-right-percent = 0.01
[diff]
	algorithm = histogram
	colorMoved = default
	guitool = cursor
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoupdate = true
[alias]
	diff-side-by-side = -c delta.features=side-by-side diff
	diff-words = diff --word-diff=color
[init]
	defaultBranch = main
{{- if eq .role "work" }}
# Work machines: signing program, certificate, and CA bundle belong in
# ~/.gitconfig.local (never committed). Example:
#   [gpg] format = x509
#   [gpg "x509"] program = smimesign
#   [user] signingkey = <certificate-id>
#   [commit] gpgsign = true
#   [http] sslCAInfo = /path/to/corporate-ca-bundle.pem
#   [includeIf "gitdir:~/src/personal/"] path = ~/.gitconfig-personal
{{- end }}
[include]
	path = ~/.gitconfig.local
