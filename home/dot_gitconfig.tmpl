[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}
[pull]
	rebase = true
[core]
	pager = delta
	excludesFile = ~/.config/git/ignore
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	line-numbers = true
	navigate = true
	hyperlinks = true
	wrap-max-lines = unlimited
	wrap-left-symbol = " "
	wrap-right-symbol = " "
	wrap-right-prefix-symbol = " "
	wrap-right-percent = 0.01
[diff]
	algorithm = histogram
	colorMoved = default
	guitool = cursor
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoupdate = true
[alias]
	diff-side-by-side = -c delta.features=side-by-side diff
	diff-words = diff --word-diff=color
[init]
	defaultBranch = main
# Machine-specific settings (signing, proxies, CA bundles) live in ~/.gitconfig.local,
# which is never committed.
[include]
	path = ~/.gitconfig.local
