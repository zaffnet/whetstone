{{- $work := get . "work" | default (dict) -}}
[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}
{{- if hasKey $work "git_signingkey" }}
	signingkey = {{ get $work "git_signingkey" }}
{{- end }}
[pull]
	rebase = true
[core]
	pager = delta
	excludesFile = ~/.config/git/ignore
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	line-numbers = true
	navigate = true
	hyperlinks = true
	wrap-max-lines = unlimited
	wrap-left-symbol = " "
	wrap-right-symbol = " "
	wrap-right-prefix-symbol = " "
	wrap-right-percent = 0.01
[diff]
	algorithm = histogram
	colorMoved = default
	guitool = cursor
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoupdate = true
[alias]
	diff-side-by-side = -c delta.features=side-by-side diff
	diff-words = diff --word-diff=color
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# Machine-specific settings (proxies, CA bundles) live in ~/.gitconfig.local, which is
# never committed.
[include]
	path = ~/.gitconfig.local
{{- if hasKey $work "git_signingkey" }}
# Declared in the order and position the corp tooling writes them, so its rewrite matches
# what chezmoi expects and the apply no longer stops to ask. These three are after the
# include, so they win over ~/.gitconfig.local; signingkey is declared up in [user], before
# it, so there the local file still wins.
[commit]
	gpgsign = true
[gpg]
	format = x509
[gpg "x509"]
	program = smimesign
{{- end }}
