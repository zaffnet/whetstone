{{- $work := get . "work" | default (dict) -}}
# Managed by chezmoi from {{ .chezmoi.workingTree }} (home/.chezmoitemplates/codex-config.toml.tmpl).
# Everything above the "preserved sections" marker is rewritten on every apply. The
# [mcp_servers.*] tables (written by bin/sync-mcp from ~/.agents/mcp.json) and Codex's own
# [projects.*] and [marketplaces.*] tables are carried over unchanged.

# The model a machine should use is not always one this public repo can name, so it is a
# [data.work] value like openai_base_url. Unset means the published default.
model = {{ get $work "codex_model" | default "gpt-5.5" | quote }}
approval_policy = "never"
sandbox_mode = "workspace-write"
model_reasoning_effort = "high"
personality = "pragmatic"
show_raw_agent_reasoning = true
hide_agent_reasoning = false
model_reasoning_summary = "detailed"
model_verbosity = "high"
file_opener = "cursor"
{{- if hasKey $work "openai_base_url" }}
openai_base_url = {{ get $work "openai_base_url" | quote }}
{{- end }}

[features]
browser_use = true
computer_use = true
apps = true
goals = true
hooks = true
js_repl = false
guardian_approval = true
prevent_idle_sleep = true
memories = true
shell_snapshot = true

[tui]
status_line = [
    "model-with-reasoning",
    "git-branch",
    "pull-request-number",
    "branch-changes",
    "context-remaining",
    "fast-mode",
    "permissions",
]
status_line_use_colors = true

[sandbox_workspace_write]
network_access = true

[memories]
generate_memories = true
use_memories = true

[shell_environment_policy]
inherit = "core"

# Values only; secrets come from the shell (~/.zsh_secrets), never from here.
[shell_environment_policy.set]
CLAUDE_CODE_MAX_OUTPUT_TOKENS = "128000"
CLAUDE_CODE_NO_FLICKER = "1"

[desktop]
followUpQueueMode = "steer"
preventSleepWhileRunning = true
git-pull-request-merge-method = "merge"
git-show-sidebar-pr-icons = true
notifications-turn-mode = "always"
conversationDetailMode = "STEPS_COMMANDS"
appearanceTheme = "system"
reviewDelivery = "inline"
git-branch-prefix = {{ get $work "branch_prefix" | default (printf "%s/" .chezmoi.username) | quote }}
git-worktree-root = {{ printf "%s/%s/" .chezmoi.homeDir .src_dir | quote }}
git-create-pull-request-as-draft = true
show-context-window-usage = true
worktree-keep-count = 15
git-pr-instructions = """
## Description

<!-- Provide a brief summary of the change in 50 words or fewer. -->

## Checklist

- [ ] Design docs reflect the code changes.
- [ ] If this PR was generated by AI, the **AI Generated** label is applied."""
git-commit-instructions = """
Ensure the first line of the commit message is 72 characters or less. Ensure entire commit message is less than 100 words.

Follow the Conventional Commits format (conventionalcommits.org):

  <type>(scope): <subject>

Where type is one of: feat, fix, refactor, chore, docs, test, ci, style, perf, build. Use imperative mood ("add", "fix", "remove", not "added", "fixes", "removed")."""

[desktop.open-in-target-preferences]
global = "cursor"

# Plugins shared with Claude Code (see ~/.agents/plugins/desired.yaml).
[plugins."github@claude-plugins-official"]
enabled = true
[plugins."pyright-lsp@claude-plugins-official"]
enabled = true
[plugins."typescript-lsp@claude-plugins-official"]
enabled = true
[plugins."claude-md-management@claude-plugins-official"]
enabled = true
[plugins."superpowers@claude-plugins-official"]
enabled = true
[plugins."playwright@claude-plugins-official"]
enabled = false

# [mcp_servers.*] is written by ~/.agents/bin/sync-mcp from ~/.agents/mcp.json after apply
# (.chezmoiscripts/run_after_40-sync-mcp.sh). One writer; Codex keeps its own
# private servers (node_repl, computer-use, event-stream) alongside.
