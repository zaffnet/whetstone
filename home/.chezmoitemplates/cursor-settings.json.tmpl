{{- $work := get . "work" | default (dict) -}}
{
	// Generated by chezmoi from whetstone home/.chezmoitemplates/cursor-settings.json.tmpl.
	// Every key below is declared there and is rewritten on the next `just apply`, so change
	// the template, not this file. A key this file does not declare is yours -- set it in
	// Cursor and an apply carries it over, under the marker at the end.
	"git.branchPrefix": {{ get $work "branch_prefix" | default (printf "%s/" .chezmoi.username) | quote }},
	"git.defaultCloneDirectory": {{ joinPath .chezmoi.homeDir .src_dir | quote }},
	"git.scanRepositories": [
		{{ joinPath .chezmoi.homeDir .src_dir | quote }}
	],
	"accessibility.dimUnfocused.enabled": false,
	"accessibility.signals.terminalBell": {
		"sound": "on"
	},
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			{
				"scope": [
					"comment",
					"punctuation.definition.comment"
				],
				"settings": {
					"fontStyle": ""
				}
			}
		]
	},
	"window.autoDetectColorScheme": false,
	"window.commandCenter": true,
	"workbench.editor.alwaysShowEditorActions": true,
	"workbench.editor.openPositioning": "last",
	"workbench.editor.limit.enabled": true,
	"workbench.editor.limit.value": 8,
	"workbench.editor.limit.perEditorGroup": false,
	"workbench.editor.limit.excludeDirty": true,
	"workbench.experimental.share.enabled": true,
	"editor.accessibilitySupport": "off",
	"editor.acceptSuggestionOnEnter": "off",
	"editor.formatOnPaste": true,
	"editor.lineHeight": 24,
	"editor.minimap.enabled": true,
	"editor.rulers": [
		88,
		100
	],
	"editor.suggest.preview": true,
	"references.preferredLocation": "view",
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "lyuwenhan.code-formatter-and-minifier"
	},
	"[markdown]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.fixAll": "explicit",
			"source.organizeImports": "explicit"
		}
	},
	"[shellscript]": {
		"editor.defaultFormatter": "mkhl.shfmt"
	},
	"[toml]": {
		"editor.defaultFormatter": "tamasfe.even-better-toml"
	},
	"files.autoSave": "afterDelay",
	"files.autoSaveDelay": 500,
	"files.exclude": {
		"**/.git": false
	},
	"markdown.preview.scrollEditorWithPreview": false,
	"markdown.preview.scrollPreviewWithEditor": false,
	"markdown.preview.typographer": true,
	"markdown.styles": [
		"https://use.fontawesome.com/releases/v5.7.1/css/all.css"
	],
	"markdownlint.severityForError": "Hint",
	"notebook.output.scrolling": true,
	"notebook.output.textLineLimit": 3000,
	"prettier.printWidth": 100,
	"prettier.proseWrap": "never",
	"terminal.external.osxExec": "iTerm.app",
	"terminal.integrated.automationProfile.osx": null,
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.cursorStyle": "line",
	"terminal.integrated.cursorWidth": 1,
	"terminal.integrated.defaultProfile.osx": "zsh",
	"terminal.integrated.enableImages": true,
	"terminal.integrated.enableVisualBell": true,
	"terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
	"terminal.integrated.fontLigatures.enabled": true,
	"terminal.integrated.fontWeight": "400",
	"terminal.integrated.gpuAcceleration": "off",
	"terminal.integrated.lineHeight": 1,
	"terminal.integrated.profiles.osx": {
		"zsh": {
			"path": "/bin/zsh",
			"args": [
				"-l"
			]
		}
	},
	"terminal.integrated.scrollback": 10000000,
	"terminal.integrated.stickyScroll.enabled": true,
	"debugpy.showPythonInlineValues": true,
	"mypy-type-checker.importStrategy": "fromEnvironment",
	"mypy-type-checker.reportingScope": "workspace",
	"python.missingPackage.severity": "Error",
	"python.terminal.activateEnvInCurrentTerminal": true,
	"python.terminal.shellIntegration.enabled": true,
	"python.venvFolders": [
		".venv"
	],
	"python-envs.terminal.autoActivationType": "shellStartup",
	"python-envs.terminal.showActivateButton": true,
	"ruff.fixAll": true,
	"ruff.organizeImports": true,
	"ruff.showSyntaxErrors": true,
	"git.alwaysShowStagedChangesResourceGroup": true,
	"git.discardUntrackedChangesToTrash": false,
	"git.enableCommitSigning": true,
	"git.fetchOnPull": true,
	"git.inputValidation": true,
	"github.showAvatar": true,
	"githubIssues.alwaysPromptForNewIssueRepo": true,
	"githubPullRequests.codingAgent.autoCommitAndPush": true,
	"githubPullRequests.codingAgent.enabled": true,
	"githubPullRequests.defaultMergeMethod": "rebase",
	"githubPullRequests.experimental.chat": true,
	"githubPullRequests.notifications": "pullRequests",
	"githubPullRequests.remotes": [
		"origin",
		"upstream"
	],
	"githubPullRequests.showPullRequestNumberInTree": true,
	"githubPullRequests.webviewRefreshInterval": 15,
	"githubPullRequests.commentExpandState": "expandUnresolved",
	"comments.openView": "file",
	"comments.visible": true,
	"comments.thread.confirmOnCollapse": "whenHasUnsubmittedComments",
	"claudeCode.usePythonEnvironment": true,
	"cursor.composer.codeBlockWordWrap": true,
	"cursor.composer.queueMessageDefaultBehavior": "stop-and-send",
	"cursor.composer.shouldChimeAfterChatFinishes": true,
	"cursor.composer.suggestNextPrompt": true,
	"cursor.cpp.disabledLanguages": [],
	"cursor.cpp.enablePartialAccepts": true,
	"cursor.general.glassShowWarningNotifications": true,
	"cursor.rpcFileLogger.enabled": true,
	"cSpell.userWords": [
		"agentic",
		"alnum",
		"autouse",
		"browsable",
		"caplog",
		"capsys",
		"coderabbit",
		"compinit",
		"conftest",
		"creds",
		"cursorignore",
		"cursorindexingignore",
		"fastapi",
		"healthcheck",
		"httpx",
		"isready",
		"iterm",
		"langfuse",
		"mypy",
		"pgdata",
		"pgrep",
		"Powerlevel",
		"pycache",
		"Pydantic",
		"pyproject",
		"pytest",
		"respx",
		"RLHF",
		"rprint",
		"shellenv",
		"sqlmodel",
		"urllib",
		"urlopen",
		"uvicorn",
		"worktreeinclude",
		"worktrees",
		"xhigh",
		"zstyle",
		"addopts",
		"aiofiles",
		"ASGI",
		"asyncio",
		"asyncpg",
		"docstrings",
		"greppable",
		"inspectable",
		"kwargs",
		"loguru",
		"ondelete",
		"pydocstyle",
		"isinstance",
		"staticmethod",
		"splitlines",
		"unconfigured",
		"venv"
	],
	"diffEditor.maxComputationTime": 0,
	"diffEditor.diffAlgorithm": "advanced",
	"diffEditor.maxFileSize": 0,
	"scm.alwaysShowRepositories": true,
	"application.shellEnvironmentResolutionTimeout": 60,
	"python.createEnvironment.contentButton": "show",
	"ruff.logLevel": "error",
	"ruff.trace.server": "verbose",
	"shellcheck.ignoreFileSchemes": [
		"git",
		"gitfs",
		"output",
		"worktree"
	],
	// A justfile is guessed as shellscript and then linted as one: `set shell :=` reads as
	// SC2121, `{{ "{{" }}VAR{{ "}}" }}` as SC1083. Recipe bodies are shell, the file is not.
	"shellcheck.ignorePatterns": {
		"**/*.worktreeinclude": true,
		"**/justfile": true,
		"**/Justfile": true,
		"**/.justfile": true,
		"**/*.just": true
	},
	"vue.hover.rich": true,
	"vue.inlayHints.destructuredProps": true,
	"vue.inlayHints.inlineHandlerLeading": true,
	"vue.inlayHints.missingProps": true,
	"vue.inlayHints.optionsWrapper": true,
	"vue.inlayHints.vBindShorthand": true,
	"claudeCode.allowDangerouslySkipPermissions": true,
	"claudeCode.initialPermissionMode": "bypassPermissions",
	"claudeCode.respectGitIgnore": false,
	"cSpell.autocorrect": true,
	"chatgpt.followUpQueueMode": "steer",
	"git.blame.editorDecoration.enabled": true,
	"gitlens.currentLine.enabled": false,
	"gitHistory.avatarCacheExpiration": 600,
	"gitHistory.includeRemoteBranches": true,
	"gitHistory.sideBySide": true,
	"github.branchProtection": false,
	"github-actions.workflows.pinned.workflows": [],
	"githubIssues.issueCompletionFormatScm": "${issueTitle} Fixes ${issueNumberLabel}",
	"cSpell.diagnosticLevel": "Hint",
	"cSpell.diagnosticLevelFlaggedWords": "Warning",
	"[vue]": {
		"editor.defaultFormatter": "Vue.volar"
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"js/ts.experimental.useTsgo": true,
	"ruff.lineLength": 100,
	"editor.minimap.showSlider": "always",
	"cursor.chatMaxWidth": 1000,
	"editor.commentOnLineNumbers": true,
	"ruff.codeAction.disableRuleComment": {
		"enable": false
	},
	"ruff.format.preview": true,
	"cursor.composer.cmdPFilePicker2": true,
	"cursor.composer.shouldShowMarkdownHoverParticipantActions2": true,
	"cursor.general.gitGraphIndexing": "enabled",
	"cursor.glassWorkspaceLspMaxLocalWorkspaces": 10,
	"cursor.glassWorkspaceLspMaxRemoteWorkspaces": 10,
	"cursor.inlineDiff.enablePerformanceProtection": false,
	"cursor.preferNotificationsSameAsChat": true,
	"cursor.semanticSearch.includeCommitsWithFiles": true,
	"cursor.worktreeCleanupIntervalHours": 120,
	"editor.fontLigatures": false,
	"editor.fontVariations": true,
	// Fira Code Medium, matching iTerm2. 500 drives the variable font's wght axis
	// (FiraCode-VF.ttf) or selects the installed FiraCode-Medium face.
	"editor.fontWeight": "500",
	"editor.formatOnSave": true,
	"diffEditor.experimental.showMoves": true,
	"diffEditor.hideUnchangedRegions.contextLineCount": 10,
	"diffEditor.hideUnchangedRegions.minimumLineCount": 5,
	"editor.minimap.maxColumn": 60,
	"editor.wordBasedSuggestions": "allDocuments",
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"workbench.commandPalette.experimental.suggestCommands": true,
	"workbench.externalBrowser": "chrome",
	"workbench.activityBar.orientation": "vertical",
	"python.languageServer": "Default",
	"pyrefly.trace.server": "verbose",
	"python.analysis.diagnosticMode": "workspace",
	"python.pyrefly.runnableCodeLens": false,
	"python.pyrefly.typeCheckingMode": "strict",
	"python.pyrefly.disableLanguageServices": false,
	"workbench.colorTheme": "Quiet Light",
	"editor.semanticHighlighting.enabled": true,
	"python.pyrefly.diagnosticMode": "workspace",
	"python.experiments.optInto": [
		"pythonPromptNewToolsExt",
		"pythonTerminalEnvVarActivation",
		"pythonTestAdapter"
	],
	"basedpyright.analysis.inlayHints.callArgumentNames": false,
	"basedpyright.analysis.inlayHints.functionReturnTypes": false,
	"basedpyright.analysis.inlayHints.variableTypes": false,
	"basedpyright.analysis.inlayHints.genericTypes": false,
	"python.terminal.useEnvFile": true,
	"gitlens.ai.enabled": false,
	"editor.fontFamily": "'Fira Code', 'Cascadia Code', monospace",
	"workbench.settings.applyToAllProfiles": [
		"editor.fontFamily",
		"editor.fontWeight"
	],
	"editor.wordWrap": "on",
	"cursor.composer.editorConversationDensity": "compact-all-grouped",
	"diffEditor.ignoreTrimWhitespace": false,
	"editor.renderWhitespace": "trailing",
	"workbench.preferredDarkColorTheme": "Quiet Light",
	"workbench.preferredHighContrastColorTheme": "Quiet Light",
	"workbench.preferredHighContrastLightColorTheme": "Quiet Light",
	"workbench.preferredLightColorTheme": "Quiet Light",
	"window.systemColorTheme": "light",
	"cursor.composer.queueManualSendBehavior": "interrupt",
	"cursor.composer.usageSummaryDisplay": "always",
	"cursor.general.reduceTransparency": true,
	"scm.inputFontSize": 12,
	"cursor.composer.textSizeScale": 0.85,
	"snyk.advanced.cliPath": {{ joinPath .chezmoi.homeDir "Library/Application Support/snyk/vscode-cli/snyk-macos-arm64" | quote }}
}
